# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Git
.git
.gitignore
README.md

# Docker files
Dockerfile*
.dockerignore
docker-compose*.yml

# Development files
.byebug_history
.irb_history
.pry_history

# Logs
log/*
*.log

# Temporary files
tmp/*
storage/*

# Environment files
.env*
!.env.example

# Test files
coverage/
.nyc_output
spec/
test/

# Node modules (will be installed in container)
node_modules/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Ruby/Rails specific
.bundle/
vendor/bundle/
.rspec
.ruby-version
.ruby-gemset

# Assets (will be compiled in container)
public/assets/
public/packs/

# Database
*.sqlite3
*.sqlite3-*

# Kamal deployment
.kamal/
